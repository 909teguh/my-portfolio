---
// src/pages/about.astro
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import profile from "../assets/profile.png";

// ── Clients / Brands ─────────────────────────────────────────
// PLACEHOLDER — ganti isinya dengan klien asli.
//   name : nama brand / studio (wajib)
//   logo : path logo di public/, mis. "/images/clients/acme.svg" (opsional)
//   url  : tautan situs klien (opsional)
const clients: { name: string; logo?: string; url?: string }[] = [
    { name: "Studio North" },
    { name: "Paper & Pixel" },
    { name: "Ninth Wave" },
    { name: "Atlas Books" },
    { name: "Lumen Games" },
    { name: "Copperline" },
    { name: "Field Notes" },
    { name: "Studio Kite" },
];
---

<BaseLayout
    title="About"
    description="Engineer by day, illustrator by passion, family man by purpose."
    hideFooter
>
    <div class="ab-page">
        <!-- ══ HERO ══ -->
        <section class="ab-hero">
            <div class="ab-hero-inner">
                <div class="ab-hero-text">
                    <h1 class="ab-hero-heading">
                        I am Teguh,<br />
                        <span class="ab-hero-heading-accent"
                            >an illustrator who works as an engineer.</span
                        >
                    </h1>
                    <p class="ab-hero-lead">
                        I’ve been working as a freelance illustrator since 2015,
                        focusing on concept art, book covers, posters, and Steam
                        capsules, mainly for the game and publishing industries.
                        I also work as a software engineer, building web
                        applications with Laravel. This site is where I keep
                        both.
                    </p>
                </div>

                <figure class="ab-hero-photo">
                    <Image
                        src={profile}
                        alt="Portrait of Teguh Suwanda"
                        widths={[240, 320, 480, 640]}
                        sizes="(max-width: 768px) 5rem, 16rem"
                        format="webp"
                        quality={82}
                        loading="eager"
                    />
                </figure>
            </div>
        </section>

        <!-- ══ CLIENTS ══ -->
        <section class="ab-clients" aria-labelledby="clients-heading">
            <div class="ab-clients-inner">
                <div class="ab-clients-head">
                    <h2 id="clients-heading" class="ab-clients-h">Clients</h2>
                    <p class="ab-clients-sub">
                        Brands and studios I’ve worked with
                    </p>
                </div>

                <ul class="ab-clients-row" id="clients-row">
                    {
                        clients.map((client) => {
                            const Tag = client.url ? "a" : "span";
                            return (
                                <li class="ab-client">
                                    <Tag
                                        class="ab-client-link"
                                        href={client.url}
                                        target={
                                            client.url ? "_blank" : undefined
                                        }
                                        rel={
                                            client.url
                                                ? "noopener noreferrer"
                                                : undefined
                                        }
                                    >
                                        {client.logo ? (
                                            <img
                                                class="ab-client-logo"
                                                src={client.logo}
                                                alt={client.name}
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        ) : (
                                            <span class="ab-client-name">
                                                {client.name}
                                            </span>
                                        )}
                                    </Tag>
                                </li>
                            );
                        })
                    }
                </ul>

                <div class="ab-clients-nav">
                    <button
                        type="button"
                        class="ab-clients-arrow"
                        data-dir="-1"
                        aria-label="Geser klien ke kiri"
                        aria-controls="clients-row"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M15 18l-6-6 6-6"></path>
                        </svg>
                    </button>
                    <button
                        type="button"
                        class="ab-clients-arrow"
                        data-dir="1"
                        aria-label="Geser klien ke kanan"
                        aria-controls="clients-row"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="M9 18l6-6-6-6"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </section>

        <!-- ══ CTA ══ -->
        <section class="ab-cta-wrap">
            <div class="ab-cta">
                <div class="ab-cta-text">
                    <h3 class="ab-cta-h">Have something in mind?</h3>
                    <p class="ab-cta-sub">
                        I’m always open to ideas, small conversations, or just
                        connecting with like-minded people.
                    </p>
                </div>

                <form
                    class="ab-cta-form"
                    action="https://api.web3forms.com/submit"
                    method="POST"
                >
                    <input
                        type="hidden"
                        name="access_key"
                        value="186b0389-5b8f-4f87-a726-9cec3479eb1c"
                    />
                    <input
                        type="hidden"
                        name="redirect"
                        value="https://suwandateguh.vercel.app/about"
                    />
                    <input
                        type="hidden"
                        name="subject"
                        value="New message from your website"
                    />

                    <div class="ab-field-row">
                        <label class="ab-field">
                            <span class="ab-field-label">Name</span>
                            <input
                                class="ab-input"
                                type="text"
                                name="name"
                                placeholder="Your name"
                                required
                            />
                        </label>
                        <label class="ab-field">
                            <span class="ab-field-label">Email</span>
                            <input
                                class="ab-input"
                                type="email"
                                name="email"
                                placeholder="you@example.com"
                                required
                            />
                        </label>
                    </div>

                    <label class="ab-field">
                        <span class="ab-field-label">Message</span>
                        <textarea
                            class="ab-input ab-textarea"
                            name="message"
                            rows="3"
                            placeholder="Tell me about your project…"
                            required
                        ></textarea>
                    </label>

                    <button type="submit" class="ab-cta-btn">Send message</button>
                </form>
            </div>
        </section>
    </div>
</BaseLayout>

<script>
    // ── Clients: geser horizontal + state tombol panah ──
    const clientsRow = document.getElementById("clients-row");
    const clientsNav = document.querySelector<HTMLElement>(".ab-clients-nav");

    if (clientsRow && clientsNav) {
        const arrows = Array.from(
            clientsNav.querySelectorAll<HTMLButtonElement>(".ab-clients-arrow"),
        );

        const syncArrows = () => {
            const maxScroll = clientsRow.scrollWidth - clientsRow.clientWidth;
            const atStart = clientsRow.scrollLeft <= 1;
            const atEnd = clientsRow.scrollLeft >= maxScroll - 1;

            arrows.forEach((btn) => {
                const dir = Number(btn.dataset.dir);
                btn.disabled =
                    maxScroll <= 1 ? true : dir < 0 ? atStart : atEnd;
            });
        };

        arrows.forEach((btn) => {
            btn.addEventListener("click", () => {
                clientsRow.scrollBy({
                    left:
                        Number(btn.dataset.dir) * clientsRow.clientWidth * 0.8,
                    behavior: "smooth",
                });
            });
        });

        clientsRow.addEventListener("scroll", syncArrows, { passive: true });
        window.addEventListener("resize", syncArrows);
        syncArrows();
    }
</script>

<style>
    /* ══════════════════════════════════════════
     GOOGLE FONTS
     Dimuat global lewat BaseLayout (Inter, Newsreader, Space Grotesk).
  ══════════════════════════════════════════ */

    /* ══════════════════════════════════════════
     DESIGN TOKENS
  ══════════════════════════════════════════ */
    :root {
        --ab-surface: #fcf9f8;
        --ab-surface-low: #f6f3f2;
        --ab-surface-cont: #f0edec;
        --ab-surface-high: #ebe7e7;
        --ab-surface-highest: #e5e2e1;
        --ab-surface-lowest: #ffffff;
        --ab-on-bg: #1c1b1b;
        --ab-on-surface-var: #554335;
        --ab-outline-var: #dbc2b0;
        --ab-primary: #8f4e00;
        --ab-primary-fixed: #ffdcc2;
        --ab-on-primary: #ffffff;
        --ab-f-head: "Inter", sans-serif;
        --ab-f-body: "Newsreader", serif;
        --ab-f-tech: "Space Grotesk", "Inter", sans-serif;
    }

    :root.dark {
        --ab-surface: #141412;
        --ab-surface-low: #1e1d1a;
        --ab-surface-cont: #252320;
        --ab-surface-high: #2a2825;
        --ab-surface-highest: #302e2b;
        --ab-surface-lowest: #232220;
        --ab-on-bg: #f5f3ee;
        --ab-on-surface-var: #c9b8ac;
        --ab-outline-var: #4a3828;
        --ab-primary: #e28112;
        --ab-primary-fixed: #3d2200;
    }

    * {
        box-sizing: border-box;
    }

    /* ══════════════════════════════════════════
     PAGE SHELL — satu layar penuh, tanpa scroll
  ══════════════════════════════════════════ */
    .ab-page {
        height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        overflow-x: hidden;
        background: var(--ab-surface);
    }

    /* ══════════════════════════════════════════
     HERO
  ══════════════════════════════════════════ */
    .ab-hero {
        flex: 1 0 auto;
        min-height: 0;
        display: flex;
        align-items: center;
        background: var(--ab-surface);
        padding: clamp(1.5rem, 5vh, 3.5rem) 5rem clamp(1rem, 3vh, 2rem);
    }

    .ab-hero-inner {
        width: 100%;
        max-width: 72rem;
        display: grid;
        grid-template-columns: minmax(0, 1fr) clamp(
                10.5rem,
                min(30vh, 22vw),
                20rem
            );
        column-gap: clamp(2rem, 4vw, 4rem);
        align-items: center;
    }

    .ab-hero-text {
        min-width: 0;
    }

    .ab-hero-heading {
        font-family: var(--ab-f-head);
        font-size: clamp(1.6rem, min(6vh, 8.5vw), 4rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.08;
        color: var(--ab-on-bg);
        margin: 0 0 clamp(0.75rem, 2vh, 1.5rem);
    }

    .ab-hero-heading-accent {
        display: block;
        margin-top: 0.35em;
        font-family: var(--ab-f-tech);
        font-size: 0.62em;
        font-weight: 300;
        line-height: 1.2;
        letter-spacing: -0.02em;
        color: var(--ab-primary);
        text-wrap: balance;
    }

    .ab-hero-lead {
        font-family: var(--ab-f-tech);
        font-size: clamp(0.9375rem, 1.9vh, 1.125rem);
        font-weight: 300;
        line-height: 1.65;
        letter-spacing: 0.002em;
        color: var(--ab-on-surface-var);
        margin: 0;
        max-width: 58ch;
        text-wrap: pretty;
    }

    /* ── Hero portrait ── */
    .ab-hero-photo {
        margin: 0;
        width: 100%;
        aspect-ratio: 4 / 5;
        border-radius: 0.75rem;
        overflow: hidden;
        background: var(--ab-surface-cont);
        box-shadow: 0 1px 2px rgba(28, 27, 27, 0.04);
    }

    :root.dark .ab-hero-photo {
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    }

    .ab-hero-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 12%;
    }

    /* ══════════════════════════════════════════
     PILLARS — 12-COL BENTO GRID
  ══════════════════════════════════════════ */
    .ab-pillars {
        background: var(--ab-surface-low);
        padding: 5rem;
    }

    .ab-grid {
        max-width: 80rem;
        margin-inline: auto;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 2rem;
    }

    /* ── Card base ── */
    .ab-card {
        border-radius: 0.5rem;
        overflow: hidden;
    }

    /* ── Image cards ── */
    .ab-card--img {
        position: relative;
    }

    .ab-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .ab-card--img:hover .ab-img {
        transform: scale(1.06);
    }

    .ab-img-tint {
        position: absolute;
        inset: 0;
        background: rgba(143, 78, 0, 0.2);
        mix-blend-mode: multiply;
        pointer-events: none;
    }

    /* ── 01 Engineer text ── */
    .ab-card--engineer {
        grid-column: span 8;
        background: var(--ab-surface-lowest);
        padding: 3rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 400px;
    }

    /* ── 01 Engineer image ── */
    .ab-card--eng-img {
        grid-column: span 4;
        min-height: 260px;
    }

    /* ── 02 Illustrator image ── */
    .ab-card--illus-img {
        grid-column: span 5;
        min-height: 500px;
    }

    /* ── 02 Illustrator text ── */
    .ab-card--illus {
        grid-column: span 7;
        background: var(--ab-surface-highest);
        padding: 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    /* ── 03 Family Man ── */
    .ab-card--family {
        grid-column: span 12;
        display: flex;
        align-items: center;
        gap: 3rem;
        margin-top: 1rem;
        background: transparent;
        border-radius: 0;
    }

    .ab-family-text {
        flex: 1;
    }

    .ab-family-imgs {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .ab-fimg {
        border-radius: 0.5rem;
        overflow: hidden;
        height: 16rem;
    }

    .ab-fimg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .ab-fimg--bottom {
        margin-top: 2rem;
    }

    /* ── Shared text styles ── */
    .ab-eyebrow {
        font-family: var(--ab-f-tech);
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--ab-primary);
        display: block;
        margin-bottom: 1.5rem;
    }

    .ab-pillar-h {
        font-family: var(--ab-f-head);
        font-size: clamp(1.5rem, 2.5vw, 2.25rem);
        font-weight: 700;
        color: var(--ab-on-bg);
        line-height: 1.2;
        letter-spacing: -0.025em;
        margin: 0 0 1.5rem;
    }

    .ab-pillar-h--serif {
        font-family: var(--ab-f-body);
        font-style: italic;
        font-weight: 400;
        letter-spacing: -0.01em;
    }

    .ab-pillar-body {
        font-family: var(--ab-f-body);
        font-size: 1.0625rem;
        line-height: 1.75;
        color: var(--ab-on-surface-var);
        max-width: 52ch;
        margin: 0;
    }

    .ab-tags {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    .ab-tag {
        font-family: var(--ab-f-head);
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.25rem 0.75rem;
        background: var(--ab-surface-cont);
        color: var(--ab-on-surface-var);
        border-radius: 0.25rem;
    }

    /* ══════════════════════════════════════════
     PHILOSOPHY
  ══════════════════════════════════════════ */
    .ab-philosophy {
        background: var(--ab-surface);
        padding: 8rem 5rem;
    }

    .ab-philosophy-inner {
        max-width: 48rem;
        margin-inline: auto;
        text-align: center;
    }

    .ab-phil-eyebrow {
        font-family: var(--ab-f-head);
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.4em;
        color: var(--ab-primary);
        display: block;
        margin-bottom: 2.5rem;
    }

    .ab-quote {
        font-family: var(--ab-f-body);
        font-style: italic;
        font-size: clamp(1.5rem, 3vw, 2.5rem);
        line-height: 1.35;
        color: var(--ab-on-bg);
        margin: 0 0 2.5rem;
        border: none;
        padding: 0;
    }

    .ab-rule {
        width: 3rem;
        height: 1px;
        background: var(--ab-outline-var);
        margin-inline: auto;
        margin-bottom: 2.5rem;
    }

    .ab-phil-body {
        font-family: var(--ab-f-body);
        font-size: 1.0625rem;
        line-height: 1.9;
        color: var(--ab-on-surface-var);
        margin: 0;
    }

    .ab-phil-body strong {
        font-weight: 600;
        font-style: italic;
        color: var(--ab-on-bg);
    }

    /* ══════════════════════════════════════════
     CLIENTS — satu baris, bisa digeser
  ══════════════════════════════════════════ */
    .ab-clients {
        flex: 0 0 auto;
        background: var(--ab-surface-low);
        padding: clamp(1rem, 2.5vh, 1.75rem) 5rem;
    }

    .ab-clients-inner {
        max-width: 72rem;
        display: grid;
        grid-template-columns: 13rem minmax(0, 1fr) auto;
        column-gap: clamp(1rem, 2.5vw, 2rem);
        align-items: center;
    }

    .ab-clients-h {
        font-family: var(--ab-f-head);
        font-size: 0.6875rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        color: var(--ab-primary);
        margin: 0 0 0.3rem;
    }

    .ab-clients-sub {
        font-family: var(--ab-f-tech);
        font-size: 0.875rem;
        font-weight: 300;
        line-height: 1.35;
        color: var(--ab-on-surface-var);
        margin: 0;
        max-width: 20ch;
    }

    /* Strip horizontal — scroll, tanpa scrollbar */
    .ab-clients-row {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        overflow-x: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }

    .ab-clients-row::-webkit-scrollbar {
        display: none;
    }

    .ab-client {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        min-height: 3.25rem;
        padding: 0 clamp(0.875rem, 1.6vw, 1.375rem);
    }

    .ab-client + .ab-client {
        border-left: 1px solid var(--ab-outline-var);
    }

    .ab-client-link {
        display: flex;
        align-items: center;
        text-decoration: none;
        color: rgba(28, 27, 27, 0.45);
        transition: color 0.2s ease;
    }

    :root.dark .ab-client-link {
        color: rgba(245, 243, 238, 0.42);
    }

    a.ab-client-link:hover,
    a.ab-client-link:focus-visible {
        color: var(--ab-primary);
    }

    .ab-client-name {
        font-family: var(--ab-f-tech);
        font-size: 0.75rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        line-height: 1.3;
        white-space: nowrap;
    }

    .ab-client-logo {
        max-height: 1.75rem;
        max-width: 8rem;
        width: auto;
        height: auto;
        object-fit: contain;
        filter: grayscale(1);
        opacity: 0.55;
        transition:
            filter 0.2s ease,
            opacity 0.2s ease;
    }

    a.ab-client-link:hover .ab-client-logo,
    a.ab-client-link:focus-visible .ab-client-logo {
        filter: grayscale(0);
        opacity: 1;
    }

    /* Panah navigasi */
    .ab-clients-nav {
        display: flex;
        gap: 0.25rem;
    }

    .ab-clients-arrow {
        width: 2rem;
        height: 2rem;
        display: grid;
        place-items: center;
        border: 1px solid var(--ab-outline-var);
        border-radius: 999px;
        background: transparent;
        color: var(--ab-on-surface-var);
        cursor: pointer;
        transition:
            color 0.15s,
            border-color 0.15s,
            opacity 0.15s;
    }

    .ab-clients-arrow:hover:not(:disabled) {
        color: var(--ab-primary);
        border-color: var(--ab-primary);
    }

    .ab-clients-arrow:disabled {
        opacity: 0.3;
        cursor: default;
    }

    /* ══════════════════════════════════════════
     CTA
  ══════════════════════════════════════════ */
    .ab-cta-wrap {
        flex: 0 0 auto;
        padding: clamp(1rem, 3vh, 2rem) 5rem clamp(1.25rem, 3.5vh, 2.5rem);
        background: var(--ab-surface);
    }

    .ab-cta {
        background: var(--ab-surface-low);
        border-radius: 0.75rem;
        padding: clamp(1rem, 2.5vh, 1.75rem) clamp(1.25rem, 2.5vw, 1.75rem);
        display: flex;
        flex-direction: column;
        gap: clamp(0.75rem, 1.8vh, 1.25rem);
    }

    .ab-cta-text {
        max-width: 52ch;
    }

    .ab-cta-h {
        font-family: var(--ab-f-head);
        font-size: clamp(1rem, 2vh, 1.25rem);
        font-weight: 700;
        color: var(--ab-on-bg);
        letter-spacing: -0.02em;
        margin: 0 0 0.2rem;
    }

    .ab-cta-sub {
        font-family: var(--ab-f-tech);
        font-size: 0.875rem;
        font-weight: 300;
        color: var(--ab-on-surface-var);
        margin: 0;
        line-height: 1.45;
    }

    .ab-cta-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
    }

    .ab-field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }

    .ab-field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 0;
    }

    .ab-field-label {
        font-family: var(--ab-f-tech);
        font-size: 0.6875rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ab-on-surface-var);
