---
// src/components/Sidebar.astro
const navLinks = [
  { href: "/", label: "Home", icon: "home" },
  { href: "/work", label: "Work", icon: "work" },
  { href: "/blog", label: "Notes", icon: "edit_note" },
  //{ href: "/now", label: "Now", icon: "today" },
  { href: "/about", label: "About", icon: "person" },
];

const currentPath = Astro.url.pathname;

// Resolve active state: exact match for root-level, startsWith for others
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};
---

<!-- ══ SIDEBAR — Desktop ══ -->
<aside class="sidebar" id="sidebar" aria-label="Navigasi utama">
  <div class="sidebar-inner">
    <!-- ── Avatar ── -->
    <div class="avatar-box" aria-label="Avatar placeholder">
      <!-- Ganti konten ini dengan <img> saat foto tersedia:
           <img src="/images/avatar.jpg" alt="Teguh Suwanda" class="avatar-img" />
      -->
      <div class="avatar-placeholder">
        <img src="/images/Logo.jpg" alt="Teguh Suwanda" class="avatar-img" />
      </div>
    </div>

    <!-- ── Brand ── -->
    <div class="sidebar-brand">
      <a href="/" class="brand-name">TEGUH SUWANDA</a>
      <p class="identity-role">Illustrator & Engineer</p>
    </div>

    <!-- ── Navigation ── -->
    <nav class="sidebar-nav" aria-label="Menu utama">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "nav-link",
              { "nav-link--active": isActive(link.href) },
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {isActive(link.href) && <span class="nav-dot" aria-hidden="true" />}
            <span class="material-symbols-outlined nav-icon" aria-hidden="true">
              {link.icon}
            </span>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="sidebar-spacer"></div>

    <!-- ── Identity + Socials ── -->
    <div class="sidebar-footer">
      <div class="sidebar-actions">
        <div class="social-links">
          <a
            href="https://instagram.com/suwandateguh"
            target="_blank"
            rel="noopener noreferrer"
            class="social-btn"
            aria-label="Instagram"
          >
            <svg
              class="social-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077"
              ></path>
            </svg>
          </a>
          <a
            href="https://github.com/909teguh"
            target="_blank"
            rel="noopener noreferrer"
            class="social-btn"
            aria-label="GitHub"
          >
            <svg
              class="social-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              ></path>
            </svg>
          </a>
        </div>
        <button
          id="theme-toggle-sidebar"
          class="theme-btn"
          aria-label="Toggle dark mode"
        >
          <span class="material-symbols-outlined icon-light">light_mode</span>
          <span class="material-symbols-outlined icon-dark">dark_mode</span>
        </button>
      </div>
    </div>
  </div>
</aside>

<!-- ══ MOBILE TOP BAR ══ -->
<header class="mobile-bar" id="mobile-bar">
  <a href="/" class="mobile-brand">The Curator</a>
  <div class="mobile-bar-right">
    <button
      id="theme-toggle-mobile"
      class="theme-btn"
      aria-label="Toggle dark mode"
    >
      <span class="material-symbols-outlined icon-light">light_mode</span>
      <span class="material-symbols-outlined icon-dark">dark_mode</span>
    </button>
    <button
      id="mobile-menu-toggle"
      class="hamburger-btn"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <span class="ham-line"></span>
      <span class="ham-line"></span>
      <span class="ham-line"></span>
    </button>
  </div>
</header>

<!-- ══ MOBILE DRAWER ══ -->
<div id="mobile-backdrop" aria-hidden="true"></div>
<div
  id="mobile-drawer"
  role="dialog"
  aria-label="Menu navigasi"
  aria-modal="true"
>
  <nav class="drawer-nav">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "drawer-link",
            { "drawer-link--active": isActive(link.href) },
          ]}
        >
          <span class="material-symbols-outlined" aria-hidden="true">
            {link.icon}
          </span>
          {link.label}
          <svg
            class="drawer-arrow"
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      ))
    }
  </nav>
  <div class="drawer-footer">
    <p class="identity-name">Teguh Suwanda</p>
    <p class="identity-role">Illustrator | Engineer</p>
  </div>
</div>

<!-- Material Symbols -->
<link
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
  rel="stylesheet"
/>

<style>
  /* ══ MATERIAL SYMBOLS ══ */
  .material-symbols-outlined {
    font-variation-settings:
      "FILL" 0,
      "wght" 300,
      "GRAD" 0,
      "opsz" 20;
    font-size: 1.125rem;
    line-height: 1;
    vertical-align: middle;
    flex-shrink: 0;
  }

  /* ══ SIDEBAR ══ */
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 16rem;
    height: 100dvh;
    z-index: 40;
    background: #f6f3f2;
    display: flex;
    flex-direction: column;
  }

  :root.dark .sidebar {
    background: #1a1917;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 2rem 2rem;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .sidebar-inner::-webkit-scrollbar {
    display: none;
  }

  /* ── Avatar Box ── */
  .avatar-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 0.5rem;
    overflow: hidden;
    margin-bottom: 1.75rem;
    background: #ede9e3;
    flex-shrink: 0;
  }

  :root.dark .avatar-box {
    background: #2a2825;
  }

  .avatar-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #887363;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Brand ── */
  .sidebar-brand {
    margin-bottom: 2rem;
  }

  .brand-name {
    font-family: "Inter", sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #1c1b1b;
    text-decoration: none;
    transition: color 0.15s;
  }

  :root.dark .brand-name {
    color: #f5f3ee;
  }

  .brand-name:hover {
    color: #8f4e00;
  }

  :root.dark .brand-name:hover {
    color: #e28112;
  }

  /* ── Navigation ── */
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: "Inter", sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(28, 27, 27, 0.55);
    text-decoration: none;
    padding: 0.4rem 0.5rem;
    border-radius: 0.375rem;
    transition:
      color 0.15s,
      background 0.15s;
    position: relative;
  }

  :root.dark .nav-link {
    color: rgba(245, 243, 238, 0.5);
  }

  .nav-link:hover {
    color: #1c1b1b;
    background: rgba(28, 27, 27, 0.05);
  }

  :root.dark .nav-link:hover {
    color: #f5f3ee;
    background: rgba(245, 243, 238, 0.07);
  }

  .nav-link--active {
    color: #8f4e00 !important;
    background: transparent !important;
  }

  :root.dark .nav-link--active {
    color: #e28112 !important;
  }

  .nav-dot {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #8f4e00;
    flex-shrink: 0;
    position: absolute;
    left: -0.75rem;
  }

  :root.dark .nav-dot {
    background: #e28112;
  }

  .nav-icon {
    opacity: 0.7;
  }

  .nav-link--active .nav-icon {
    opacity: 1;
  }

  /* ── Spacer ── */
  .sidebar-spacer {
    flex: 1;
    min-height: 2rem;
  }

  /* ── Footer ── */
  .sidebar-footer {
    border-top: 1px solid rgba(28, 27, 27, 0.08);
    padding-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :root.dark .sidebar-footer {
    border-top-color: rgba(245, 243, 238, 0.08);
  }

  .identity-name {
    font-family: "Inter", sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    color: #1c1b1b;
    margin: 0 0 0.2rem;
  }

  :root.dark .identity-name {
    color: #f5f3ee;
  }

  .identity-role {
    font-family: "Inter", sans-serif;
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #887363;
    margin: 0;
  }

  :root.dark .identity-role {
    color: #a8a29e;
  }

  .sidebar-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .social-links {
    display: flex;
    gap: 0.25rem;
  }

  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    color: rgba(28, 27, 27, 0.5);
    text-decoration: none;
    transition:
      color 0.15s,
      background 0.15s;
  }

  :root.dark .social-btn {
    color: rgba(245, 243, 238, 0.45);
  }

  .social-icon {
    width: 1.0625rem;
    height: 1.0625rem;
    display: block;
    flex-shrink: 0;
  }

  .social-btn:hover {
    color: #8f4e00;
    background: rgba(143, 78, 0, 0.08);
  }

  :root.dark .social-btn:hover {
    color: #e28112;
    background: rgba(226, 129, 18, 0.1);
  }

  /* ── Theme toggle ── */
  .theme-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.375rem;
    border: 1px solid rgba(28, 27, 27, 0.1);
    background: transparent;
    color: rgba(28, 27, 27, 0.5);
    cursor: pointer;
    transition:
      color 0.15s,
      background 0.15s,
      border-color 0.15s;
    flex-shrink: 0;
  }

  :root.dark .theme-btn {
    border-color: rgba(245, 243, 238, 0.1);
    color: rgba(245, 243, 238, 0.5);
  }

  .theme-btn:hover {
    color: #8f4e00;
    border-color: #8f4e00;
    background: rgba(143, 78, 0, 0.06);
  }

  :root.dark .theme-btn:hover {
    color: #e28112;
    border-color: #e28112;
    background: rgba(226, 129, 18, 0.08);
  }

  /* Show/hide sun/moon based on theme */
  :root:not(.dark) .icon-dark {
    display: none;
  }
  :root.dark .icon-light {
    display: none;
  }

  /* ══ MOBILE BAR ══ */
  .mobile-bar {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 3.25rem;
    padding: 0 1.25rem;
    align-items: center;
    justify-content: space-between;
    background: rgba(246, 243, 242, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(28, 27, 27, 0.06);
  }

  :root.dark .mobile-bar {
    background: rgba(26, 25, 23, 0.92);
    border-bottom-color: rgba(245, 243, 238, 0.06);
  }

  .mobile-brand {
    font-family: "Inter", sans-serif;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #1c1b1b;
    text-decoration: none;
  }

  :root.dark .mobile-brand {
    color: #f5f3ee;
  }

  .mobile-bar-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hamburger-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: 1px solid rgba(28, 27, 27, 0.1);
    border-radius: 0.375rem;
    cursor: pointer;
    padding: 0 7px;
    transition: border-color 0.15s;
  }

  :root.dark .hamburger-btn {
    border-color: rgba(245, 243, 238, 0.1);
  }

  .ham-line {
    display: block;
    height: 1.5px;
    background: #554335;
    border-radius: 2px;
    transition:
      transform 0.25s ease,
      opacity 0.2s;
  }

  :root.dark .ham-line {
    background: #c9b8ac;
  }

  /* Hamburger → X animation */
  .hamburger-btn[aria-expanded="true"] .ham-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .hamburger-btn[aria-expanded="true"] .ham-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger-btn[aria-expanded="true"] .ham-line:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* ══ MOBILE BACKDROP ══ */
  #mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(28, 27, 27, 0.45);
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  #mobile-backdrop.is-open {
    display: block;
    opacity: 1;
  }

  /* ══ MOBILE DRAWER ══ */
  #mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    width: min(20rem, 85vw);
    background: #f6f3f2;
    display: flex;
    flex-direction: column;
    padding: 5rem 1.5rem 2.5rem;
    transform: translateX(110%);
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
    visibility: hidden;
  }

  :root.dark #mobile-drawer {
    background: #1a1917;
  }

  #mobile-drawer.is-open {
    transform: translateX(0);
    visibility: visible;
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 0.5rem;
    font-family: "Inter", sans-serif;
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgba(28, 27, 27, 0.6);
    text-decoration: none;
    transition:
      background 0.15s,
      color 0.15s;
  }

  :root.dark .drawer-link {
    color: rgba(245, 243, 238, 0.55);
  }

  .drawer-link:hover {
    background: rgba(28, 27, 27, 0.05);
    color: #1c1b1b;
  }

  :root.dark .drawer-link:hover {
    background: rgba(245, 243, 238, 0.06);
    color: #f5f3ee;
  }

  .drawer-link--active {
    color: #8f4e00 !important;
    background: rgba(143, 78, 0, 0.07) !important;
  }

  :root.dark .drawer-link--active {
    color: #e28112 !important;
    background: rgba(226, 129, 18, 0.1) !important;
  }

  .drawer-arrow {
    margin-left: auto;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.15s,
      transform 0.15s;
    flex-shrink: 0;
  }

  .drawer-link:hover .drawer-arrow,
  .drawer-link--active .drawer-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .drawer-footer {
    border-top: 1px solid rgba(28, 27, 27, 0.08);
    padding-top: 1.25rem;
  }

  :root.dark .drawer-footer {
    border-top-color: rgba(245, 243, 238, 0.08);
  }

  /* ══ RESPONSIVE ══ */
  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }
    .mobile-bar {
      display: flex;
    }
  }

  @media (min-width: 769px) {
    #mobile-drawer,
    #mobile-backdrop,
    .mobile-bar {
      display: none !important;
    }
  }
</style>

<script>
  // ── Theme ──
  const getTheme = () =>
    localStorage.getItem("theme") ??
    (window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light");

  const applyTheme = (theme: string) => {
    document.documentElement.classList.toggle("dark", theme === "dark");
    localStorage.setItem("theme", theme);
  };

  const toggleTheme = () =>
    applyTheme(
      document.documentElement.classList.contains("dark") ? "light" : "dark",
    );

  applyTheme(getTheme());

  document
    .getElementById("theme-toggle-sidebar")
    ?.addEventListener("click", toggleTheme);
  document
    .getElementById("theme-toggle-mobile")
    ?.addEventListener("click", toggleTheme);

  // ── Mobile drawer ──
  const menuToggle = document.getElementById(
    "mobile-menu-toggle",
  ) as HTMLButtonElement;
  const drawer = document.getElementById("mobile-drawer")!;
  const backdrop = document.getElementById("mobile-backdrop")!;

  let drawerOpen = false;

  function openDrawer() {
    drawerOpen = true;
    menuToggle.setAttribute("aria-expanded", "true");
    drawer.classList.add("is-open");
    backdrop.style.display = "block";
    requestAnimationFrame(() => {
      backdrop.classList.add("is-open");
    });
    document.body.style.overflow = "hidden";
    drawer.querySelector<HTMLElement>(".drawer-link")?.focus();
  }

  function closeDrawer() {
    drawerOpen = false;
    menuToggle.setAttribute("aria-expanded", "false");
    drawer.classList.remove("is-open");
    backdrop.classList.remove("is-open");
    setTimeout(() => {
      backdrop.style.display = "none";
    }, 250);
    document.body.style.overflow = "";
    menuToggle.focus();
  }

  menuToggle?.addEventListener("click", () =>
    drawerOpen ? closeDrawer() : openDrawer(),
  );
  backdrop?.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawerOpen) closeDrawer();
  });

  drawer?.querySelectorAll(".drawer-link").forEach((link) => {
    link.addEventListener("click", closeDrawer);
  });

  // Trap focus in drawer
  drawer?.addEventListener("keydown", (e) => {
    if (!drawerOpen || e.key !== "Tab") return;
    const focusable = drawer.querySelectorAll<HTMLElement>(
      'a[href], button, [tabindex]:not([tabindex="-1"])',
    );
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
